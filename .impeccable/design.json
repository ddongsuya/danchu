{
  "version": 1,
  "name": "Danchu Research Workspace",
  "source": "app/globals.css",
  "mode": "code-led",
  "colors": {
    "primary": "#1b1b19",
    "accent": "#edef5c",
    "accentTint": "#f5f6b4",
    "background": "#f4f4f0",
    "surface": "#fbfbf8",
    "text": "#1b1b19",
    "darkPrimary": "#efefea"
  },
  "radii": {
    "small": "2px",
    "medium": "2px",
    "large": "4px"
  },
  "typeface": "Host Grotesk + Pretendard Variable",
  "motion": {
    "press": "160ms",
    "drawer": "220ms",
    "reducedMotion": true
  },
  "breakpoints": {
    "mobile": 599,
    "publicStack": 899,
    "portalSidebar": 960
  },
  "zIndex": {
    "nav": 20,
    "overlay": 40,
    "modal": 50,
    "toast": 60
  }
}
