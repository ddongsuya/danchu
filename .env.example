# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # 서버 전용. 절대 NEXT_PUBLIC_ 붙이지 말 것
# 로그인 세션(쿠키)용 공개 키 — 데이터 접근 권한은 없다 (모든 표는 RLS로 잠겨 있음)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- 사이트 주소 (메일 링크에 사용) ---
NEXT_PUBLIC_SITE_URL=https://danchu.kr

# --- Resend ---
RESEND_API_KEY=re_...
# 도메인 인증 전에는 onboarding@resend.dev 만 발신 가능 (수신은 Resend 가입 메일로만)
RESEND_FROM=단추 <hello@danchu.kr>
# 운영자 메일 (쉼표로 여러 개). 이 주소로 가입하면 자동으로 운영자 권한이 부여된다.
ADMIN_EMAIL=ops@example.com
