# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # 서버 전용. 절대 NEXT_PUBLIC_ 붙이지 말 것
# 로그인 세션(쿠키)용 공개 키 — 데이터 접근 권한은 없다 (모든 표는 RLS로 잠겨 있음)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- 사이트 주소 (메일 링크에 사용) ---
NEXT_PUBLIC_SITE_URL=https://danchu.kr

# --- Resend ---
RESEND_API_KEY=re_...
# 도메인 인증 전에는 onboarding@resend.dev 만 발신 가능 (수신은 Resend 가입 메일로만)
RESEND_FROM=단추 <hello@danchu.kr>
# 운영자 알림 메일 수신 주소 (쉼표로 여러 개). 권한과는 무관하다 — 운영자 지정은 profiles.role 로 한다 (README).
ADMIN_EMAIL=ops@example.com

# --- 예약 실행 (Vercel Cron) ---
# 매일 09:00 KST에 /api/cron/daily 호출. Vercel이 Authorization: Bearer <CRON_SECRET> 헤더로 인증한다.
CRON_SECRET=

# Local design review only. Never required for real authentication or business data.
# DANCHU_DESIGN_PREVIEW=1

# --- 오류 모니터링 (Sentry, 선택이지만 운영에서는 켜 둘 것) ---
# 서버용. 비어 있으면 Sentry 를 끼우지 않고 콘솔 로그만 남는다
SENTRY_DSN=
# 브라우저용 (같은 값이어도 된다)
NEXT_PUBLIC_SENTRY_DSN=
# 소스맵 업로드용. 없으면 업로드만 생략된다
SENTRY_AUTH_TOKEN=
